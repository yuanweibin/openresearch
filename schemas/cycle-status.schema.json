{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuanweibin/openresearch/schemas/cycle-status.schema.json",
  "title": "OpenResearch Cycle status frontmatter",
  "type": "object",
  "required": [
    "artifact",
    "schema_version",
    "cycle",
    "execution_state",
    "scientific_state",
    "approval",
    "program_design_revision",
    "main_variable",
    "next_legal_action",
    "updated_at"
  ],
  "properties": {
    "artifact": { "const": "cycle-status" },
    "schema_version": { "const": "0.1.0" },
    "cycle": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "execution_state": {
      "enum": ["designed", "running", "evidence-ready", "diagnosed", "blocked", "complete"]
    },
    "scientific_state": {
      "enum": ["pending", "supported", "refuted", "inconclusive", "failed-with-diagnosis"]
    },
    "approval": { "enum": ["pending", "approved", "changes-requested"] },
    "approved_at": { "type": ["string", "null"] },
    "owner": { "type": ["string", "null"] },
    "program_design_revision": { "type": "string", "minLength": 1 },
    "main_variable": { "type": "string", "minLength": 1 },
    "next_legal_action": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
